{
  "name": "@learnable/extractor",
  "version": "0.1.0",
  "description": "Scans a repository and emits a Learnable knowledge base.",
  "type": "module",
  "bin": {
    "learnable": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "scan": "npm run build && node dist/cli.js scan",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "smol-toml": "^1.3.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.22.6",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
